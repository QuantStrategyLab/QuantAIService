{
  "name": "CONFIGURE_WORKER_NAME",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "vars": {
    "ORGANIZATION": "quant",
    "ORGANIZATION_ID": "Quant",
    "PUBLIC_ORIGIN": "https://tasks.example.test",
    "PROJECT_ID": "CONFIGURE_EXISTING_PROJECT",
    "TASK_STORE_NAME": "CONFIGURE_STORE_NAME",
    "AUTH_CLIENTS": {},
    "ADMISSIONS_JSON": "[]",
    "PROJECT_CONTEXTS": {},
    "PROJECT_POLICIES": {},
    "AGENT_PROVIDERS": {
      "muse": {
        "type": "muse",
        "enabled": true
      }
    },
    "API_PROVIDERS": {
      "gemini": {
        "type": "gemini_api",
        "enabled": false,
        "model": "CONFIGURE_APPROVED_EXACT_MODEL",
        "key_env": "AI_SERVICE_GEMINI_API_KEY",
        "api_usage_authorized": false
      }
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "CONFIGURE_NAMESPACE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_STATE",
        "class_name": "PersonalTaskStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PersonalTaskStore"
      ]
    }
  ],
  "services": [
    {
      "binding": "TASK_SERVICE",
      "service": "CONFIGURE_WORKER_NAME",
      "entrypoint": "TaskService"
    }
  ],
  "no_bundle": true
}
